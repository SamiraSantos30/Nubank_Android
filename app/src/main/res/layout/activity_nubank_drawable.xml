<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"

    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/main"
    android:orientation="vertical"
    tools:context=".MainActivity"
    >

    <include layout="@layout/activity_toolbar" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:text="Conta"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=" R$69.000"
        android:layout_marginStart="10dp"/>


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:backgroundTint="#E0E0E0"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:padding="8dp">


        <ImageButton
            android:id="@+id/pix"
            android:layout_width="73dp"
            android:layout_height="73dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/redondobutton"
            android:backgroundTint="#E0E0E0"
            android:src="@mipmap/pix_foreground" />

        <ImageButton
            android:layout_width="73dp"
            android:layout_height="73dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#E0E0E0"
            android:background="@drawable/redondobutton"
            android:src="@mipmap/dinheiro_foreground"
            />

        <ImageButton
            android:layout_width="73dp"
            android:layout_height="73dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/redondobutton"
            android:src="@mipmap/setapracima_foreground"
            android:backgroundTint="#E0E0E0"
            />

        <ImageButton
            android:layout_width="73dp"
            android:layout_height="73dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/redondobutton"
            android:backgroundTint="#E0E0E0"
            android:src="@mipmap/seta_para_baixo_foreground"

            />

    </LinearLayout>


    <Button
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:backgroundTint="#E0E0E0"
        android:src="@mipmap/cartao"
        android:text="meus cartoes"
        android:textColor="@android:color/black"
        app:cornerRadius="15dp"

        />


    <Button
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:src="@mipmap/cartao"
        app:cornerRadius="15dp"
        android:backgroundTint="#E0E0E0"
        android:text="Conheça o nubanck vida um seguro simples e que cabe no bolso"
        android:textColor="@android:color/black" />

    <ImageButton
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="15dp"
        android:background="@null"
        android:backgroundTint="#E0E0E0"
        android:src="@mipmap/cartao" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="cartão de credito"
        android:textStyle="bold"
        android:layout_marginTop="15dp"
        android:layout_marginStart="10dp"
        android:textSize="15sp"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="fatura atual"
        android:layout_marginStart="10dp"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="R$15,789"
        android:textStyle="bold"
        android:layout_marginTop="15dp"
        android:layout_marginStart="10dp"
        android:textSize="15sp"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="limite disponivel de R$ 32.450,00"
        android:layout_marginStart="10dp"
        />

</LinearLayout>

