<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.Toolbar
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/toolbar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#a020f0"
    app:title="Olá, Samira"
    app:titleTextColor="#ffffff"
    tools:ignore="ExtraText">

    <!-- Container para as imagens no canto direito -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:orientation="horizontal"
        android:layout_marginEnd="8dp"
        android:padding="4dp"
        >

        <ImageView
            android:id="@+id/icon1"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@mipmap/olho_foreground"
            android:layout_marginStart="8dp"
            android:contentDescription="Ícone 1"
            />

        <ImageView
            android:id="@+id/icon2"
            android:layout_width="42dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Ícone 2"
            android:src="@mipmap/interrogacao_foreground" />

        <ImageView
            android:id="@+id/icon3"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@mipmap/ienvelope_foreground"
            android:layout_marginStart="8dp"
            android:contentDescription="Ícone 3"
            />


    </LinearLayout>

</androidx.appcompat.widget.Toolbar>

