<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".nona_tela">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Transferência realizada!!"
        android:textSize="25sp"
        android:layout_marginTop="30dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Para mais detalhes veja o histórico de transações da sua conta."
        android:layout_marginTop="20dp"
        android:textSize="20sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="R$689,56"
        android:textSize="40sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="40dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Para Fulana"
        android:textStyle="bold"
        android:textSize="25sp"
        android:gravity="center"
        android:layout_marginTop="10dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Agora mesmo - 21h45min"
        android:gravity="center"
        android:layout_marginTop="10dp" />

    <Button
        android:id="@+id/tranferenciaRealizada"
        android:layout_width="380dp"
        android:layout_height="wrap_content"
        android:text="Transferir"
        android:textColor="@android:color/white"
        android:backgroundTint="#851b87"
        android:layout_gravity="center"
        android:layout_marginTop="50dp" />

</LinearLayout>
