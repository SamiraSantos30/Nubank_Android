<?xml version="1.0" encoding="utf-8"?>
<LinearLayout  xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    tools:context=".quarta_tela"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:layout_width="372dp"
        android:layout_height="39dp"
        android:layout_marginTop="30dp"
        android:text="Para quem voce quer transferir"
        android:textSize="25dp"
         />

    <TextView
        android:layout_width="361dp"
        android:layout_height="28dp"
        android:text="R$689,56?"
        android:textSize="25dp"
         />

    <TextView
        android:layout_width="341dp"
        android:layout_height="47dp"
        android:text="Encontre um contato na sua lista ou inicie uma nova transferencia"
        android:textSize="20dp"
      />

    <EditText
        android:layout_width="353dp"
        android:layout_height="47dp"
        android:hint="Nome,CPF/CNPJ ou chave pix"
        android:textSize="20dp"
      />

    <TextView
        android:layout_width="302dp"
        android:layout_height="28dp"
        android:layout_marginTop="30dp"
        android:text="Contatos Frequentes"
        android:textSize="15dp"/>




    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:backgroundTint="#E0E0E0"
        android:orientation="horizontal"
       >

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            >

            <ImageButton
                android:id="@+id/Fulana"
                android:layout_width="73dp"
                android:layout_height="73dp"
                android:background="@drawable/redondobutton"
                android:backgroundTint="#E0E0E0"
                android:src="@mipmap/boneco" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fulana"
                android:textSize="15sp"
                tools:ignore="MissingConstraints"

                />

        </LinearLayout>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="8dp"

            >
            <ImageButton
                android:layout_width="73dp"
                android:layout_height="73dp"
                android:backgroundTint="#E0E0E0"
                android:background="@drawable/redondobutton"
                android:src="@mipmap/boneco"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bertana"
                android:textSize="15sp"
                tools:ignore="MissingConstraints,TextSizeCheck"

                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="8dp"
            >
            <ImageButton
                android:layout_width="73dp"
                android:layout_height="73dp"
                android:background="@drawable/redondobutton"
                android:src="@mipmap/boneco"
                android:backgroundTint="#E0E0E0"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cicrana"/>

        </LinearLayout>


    </LinearLayout>

    <TextView
        android:layout_width="162dp"
        android:layout_height="30dp"
        android:text="Todos os contatos"
        android:textStyle="bold"
        android:textSize="19dp"
        android:layout_marginTop="60dp"

        />



    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="15dp"
        android:padding="8dp">

        <ImageButton
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:backgroundTint="#E0E0E0"
            android:background="@drawable/redondobutton"
            android:src="@mipmap/boneco"
            android:contentDescription="Ícone de Fulano"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fulano"
            android:textSize="18dp"
            android:layout_marginStart="12dp"
            />
    </LinearLayout>



    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <ImageButton
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:backgroundTint="#E0E0E0"
            android:background="@drawable/redondobutton"
            android:src="@mipmap/boneco"
            android:contentDescription="Ícone de Fulano"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cicrano"
            android:textSize="18sp"
            android:layout_marginStart="12dp"
            />
    </LinearLayout>


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <ImageButton
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:backgroundTint="#E0E0E0"
            android:background="@drawable/redondobutton"
            android:src="@mipmap/boneco"
            android:contentDescription="Ícone de Fulano"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bertano"
            android:textSize="18sp"
            android:layout_marginStart="12dp"
            />
    </LinearLayout>


    </LinearLayout>